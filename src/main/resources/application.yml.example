# application.yml THẬT không được push (tránh lộ secret) — copy file này thành
# application.yml rồi tự điền giá trị của máy bạn.
#
# Các key app.jwt.* và app.admin.* lấy đúng từ @ConfigurationProperties /
# @Value trong code (JwtProperties.java, AdminBootstrapRunner.java) — không bịa.
# Các key spring.* là chuẩn Spring Boot, cần verify lại đúng tên property mới
# nhất đang dùng trong pom.xml (Spring Boot 3.3) trước khi tin 100%.

spring:
  application:
    name: bep-mo-backend

  datasource:
    url: jdbc:postgresql://localhost:5432/bepmo
    username: bepmo
    password: ${DB_PASSWORD}

  jpa:
    hibernate:
      ddl-auto: validate   # Flyway quản lý toàn bộ schema, không để Hibernate tự sinh DDL
    open-in-view: false

  flyway:
    enabled: true
    locations: classpath:db/migration

  data:
    redis:
      host: localhost
      port: 6379
      connect-timeout: 1s
      timeout: 1s

app:
  jwt:
    secret: ${JWT_SECRET}                     # tối thiểu 32 ký tự
    access-token-expiration-ms: 900000        # 15 phút — verify lại con số thật trong code/JwtUtil trước khi tin
    refresh-token-expiration-ms: 2592000000   # 30 ngày — verify lại con số thật

  admin:
    email: ${ADMIN_EMAIL:admin@bepmo.local}
    password: ${ADMIN_PASSWORD}

  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}

  cloudinary:
    cloud-name: ${CLOUDINARY_CLOUD_NAME:}
    api-key: ${CLOUDINARY_API_KEY:}
    api-secret: ${CLOUDINARY_API_SECRET:}
    # Optional SIGNED preset. Leave blank to sign timestamp/public_id/overwrite directly.
    upload-preset: ${CLOUDINARY_UPLOAD_PRESET:}
    upload-session-ttl-seconds: ${MEDIA_UPLOAD_SESSION_TTL_SECONDS:600}

server:
  port: 8080
