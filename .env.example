DB_PASSWORD=replace_with_a_local_database_password
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=admin@bepmo.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Backend-only Cloudinary credentials. Never expose API_SECRET in the frontend.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
# Optional signed upload preset configured in Cloudinary Console.
CLOUDINARY_UPLOAD_PRESET=
MEDIA_UPLOAD_SESSION_TTL_SECONDS=600
