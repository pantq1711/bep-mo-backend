    },
    {
      "name": "RecentProof",
      "item": [
        {
          "name": "Create (owner only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proofType\": \"INVOICE\",\n  \"mediaUrl\": \"https://res.cloudinary.com/demo/image/upload/v1/invoice.jpg\",\n  \"cloudinaryPublicId\": \"invoice_demo_1\",\n  \"note\": \"Hoá đơn nhập thịt heo sáng nay\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recent-proofs",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "recent-proofs"]
            },
            "description": "proofType: INGREDIENT_PHOTO | INVOICE | DELIVERY_NOTE | PACKAGE_LABEL | RECEIVING_VIDEO. KHÔNG gửi mediaKind — backend tự suy (RECEIVING_VIDEO -> VIDEO, còn lại -> IMAGE)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('proofId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List 3 most recent (public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recent-proofs",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "recent-proofs"]
            }
          }
        },
        {
          "name": "Delete (owner only, soft delete)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recent-proofs/{{proofId}}",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "recent-proofs", "{{proofId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "TransparencyScore",
      "item": [
        {
          "name": "Get score (public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/transparency-score",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "transparency-score"]
            },
            "description": "Completeness 80đ (ingredient source ACTIVE +15, video INGREDIENT_RECEIVING +20, KITCHEN +20, HYGIENE +15, PREP +10) + Freshness 20đ (proof <=7 ngày +20, 8-14 ngày +10, >14 ngày/không có +0). Tính on-demand, cache Redis, không lưu DB."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Cần token của user có role ADMIN — collection này không tự tạo sẵn tài khoản admin (phải seed tay ở DB hoặc migration riêng).",
      "item": [
        { "name": "Hide restaurant", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/restaurants/{{restaurantId}}/hide", "host": ["{{baseUrl}}"], "path": ["admin", "restaurants", "{{restaurantId}}", "hide"] } } },
        { "name": "Unhide restaurant", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/restaurants/{{restaurantId}}/unhide", "host": ["{{baseUrl}}"], "path": ["admin", "restaurants", "{{restaurantId}}", "unhide"] } } },
        { "name": "Hide video", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/videos/{{videoId}}/hide", "host": ["{{baseUrl}}"], "path": ["admin", "videos", "{{videoId}}", "hide"] } } },
        { "name": "Unhide video", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/videos/{{videoId}}/unhide", "host": ["{{baseUrl}}"], "path": ["admin", "videos", "{{videoId}}", "unhide"] } } },
        { "name": "Hide ingredient source", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/ingredient-sources/{{sourceId}}/hide", "host": ["{{baseUrl}}"], "path": ["admin", "ingredient-sources", "{{sourceId}}", "hide"] } } },
        { "name": "Unhide ingredient source", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/ingredient-sources/{{sourceId}}/unhide", "host": ["{{baseUrl}}"], "path": ["admin", "ingredient-sources", "{{sourceId}}", "unhide"] } } },
        { "name": "Hide recent proof", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/recent-proofs/{{proofId}}/hide", "host": ["{{baseUrl}}"], "path": ["admin", "recent-proofs", "{{proofId}}", "hide"] } } },
        { "name": "Unhide recent proof", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/admin/recent-proofs/{{proofId}}/unhide", "host": ["{{baseUrl}}"], "path": ["admin", "recent-proofs", "{{proofId}}", "unhide"] } } },
        { "name": "Disable user", "request": { "method": "PATCH", "header": [], "url": { "raw": "{{baseUrl}}/admin/users/:userId/disable", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":userId", "disable"], "variable": [{ "key": "userId", "value": "" }] } } },
        { "name": "Enable user", "request": { "method": "PATCH", "header": [], "url": { "raw": "{{baseUrl}}/admin/users/:userId/enable", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":userId", "enable"], "variable": [{ "key": "userId", "value": "" }] } } }
      ]
    }
  ]
}
